;;; ---- driver -----------------------------------------------------------
(defun t:dump (path / f en tn tab)
  (setq f (open path "w" "utf8"))
  (princ (strcat "HANDSEED=" (vl-princ-to-string (getvar "HANDSEED")) (chr 10)) f)
  (setq en (entnext))
  (while en (princ (strcat (vl-princ-to-string (entget en '("*"))) (chr 10)) f) (setq en (entnext en)))
  (foreach tab '("LAYER" "BLOCK" "APPID" "LTYPE" "STYLE" "DIMSTYLE" "VIEW" "UCS")
    (setq tn (tblnext tab T))
    (while tn (princ (strcat tab ":" (vl-princ-to-string tn) (chr 10)) f) (setq tn (tblnext tab))))
  (close f))
(defun t:run-scene (name root / runs r res spec msg)
  (t:reset)
  (setq t:last-insert nil)
  (setq res (vl-catch-all-apply (read (strcat "t:s-" name)) nil))
  (if (vl-catch-all-error-p res)
    (princ (strcat (chr 10) "SCENE_ERROR " name " " (vl-catch-all-error-message res)))
    (progn
      (setq runs res)
      (t:dump (strcat root name "_before.txt"))
      (foreach r runs
        (setq spec (if (listp r) (car r) r))
        (setq ard:out-dir (strcat root name "/" spec "/"))
        (setq msg (vl-catch-all-apply 'ard:run (list spec (if (listp r) (cadr r) nil))))
        (if (vl-catch-all-error-p msg)
          (princ (strcat (chr 10) "RUN_ERROR " name " " spec " " (vl-catch-all-error-message msg)))))
      (t:dump (strcat root name "_after.txt"))
      (princ (strcat (chr 10) "SCENE_DONE " name)))))
(princ)
