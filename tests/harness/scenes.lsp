(defun t:s-mixed-paths (/ j)
  (t:defs) (t:ensure-layer "SCADA-TRAY-PATH") (t:ensure-layer "SCADA-TRAY")
  (setq j '(0.0 0.0))
  ;; elbow with arms W (SCADA_V2 path) and S (SCADA_BASIC path); fitting is V2
  (t:path (list j '(-2500.0 0.0)) "SCADA_V2" 300.0)
  (t:path (list j '(0.0 -2500.0)) "SCADA_BASIC" 300.0)
  (t:straight j '(-1.0 0.0) t:tk (+ t:tk 1000.0) 300.0)
  (t:straight j '(0.0 -1.0) t:tk (+ t:tk 1000.0) 300.0)
  (t:insert "SCADA_V2$SCADA_TRAY_ELBOW_V2" (t:fit-ip j 2 1.0 '(0.0 0.0)) 2 1.0 "ELBOW")
  (list "all"))
